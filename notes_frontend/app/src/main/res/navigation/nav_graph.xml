<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/notesListFragment" >

    <fragment
        android:id="@+id/notesListFragment"
        android:name="com.example.notesfrontend.ui.NotesListFragment"
        android:label="Notes"
        tools:layout="@layout/fragment_notes_list">
        <action
            android:id="@+id/action_notesListFragment_to_noteEditFragment"
            app:destination="@id/noteEditFragment" />
        <action
            android:id="@+id/action_notesListFragment_to_noteDetailFragment"
            app:destination="@id/noteDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/noteEditFragment"
        android:name="com.example.notesfrontend.ui.NoteEditFragment"
        android:label="@string/title_note_edit"
        tools:layout="@layout/fragment_note_edit" >
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1" />
    </fragment>
    
    <fragment
        android:id="@+id/noteDetailFragment"
        android:name="com.example.notesfrontend.ui.NoteDetailFragment"
        android:label="@string/title_note_detail"
        tools:layout="@layout/fragment_note_detail" >
        <argument
            android:name="noteId"
            app:argType="long" />
        <action
            android:id="@+id/action_noteDetailFragment_to_noteEditFragment"
            app:destination="@id/noteEditFragment" />
    </fragment>

</navigation>
